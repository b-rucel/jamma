{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.AsyncIterable"],
    "types": ["bun"],
    "strict": true,
    "resolveJsonModule": true,
    "declaration": true,
    "outDir": "lib",
    "skipLibCheck": true
  },
  "include": ["src", "scripts"]
}
